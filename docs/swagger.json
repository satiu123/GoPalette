        "/search": {
            "get": {
                "description": "基于 MySQL FULLTEXT 索引（倒排索引原理）搜索文章标题和正文",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "全文搜索",
                "parameters": [
                    {
                        "type": "string",
                        "description": "搜索关键词",
                        "name": "q",
