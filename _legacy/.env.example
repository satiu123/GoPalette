SERVER_ADDR=:8080
SERVER_ENV=development

JWT_ACCESS_TOKEN_SECRET=replace-with-strong-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

MYSQL_ROOT_PASSWORD=replace-with-db-password
DATABASE_DSN=root:replace-with-db-password@tcp(localhost:3306)/gopalette?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=replace-with-redis-password
